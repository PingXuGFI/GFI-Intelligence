<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GL Framework · Governance Logic</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: #0b1220;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'DM Sans', 'DM Mono', system-ui, sans-serif;
      padding: 40px 20px;
    }
    .figure-container {
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      background: #0b1220;
      border-radius: 24px;
    }
    svg {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 16px;
    }
    @media (max-width: 768px) {
      body { padding: 20px; }
    }
  </style>
</head>
<body>
<div class="figure-container">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 950" font-family="'DM Sans', 'DM Mono', system-ui, sans-serif">
    <defs>
      <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#0b1220;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#111827;stop-opacity:1" />
      </linearGradient>
      <filter id="glow">
        <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <filter id="shadow">
        <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000" flood-opacity="0.3"/>
      </filter>
      <marker id="arrowGreen" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#9FE870"/>
      </marker>
      <marker id="arrowBlue" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#7DD3FC"/>
      </marker>
      <marker id="arrowRed" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#ff6b6b"/>
      </marker>
      <marker id="arrowGold" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#fbbf24"/>
      </marker>
    </defs>

    <!-- 背景 -->
    <rect width="1200" height="950" fill="url(#bgGrad)" rx="16"/>

    <!-- 主標題 -->
    <text x="600" y="48" text-anchor="middle" fill="#f8fbff" font-size="22" font-weight="700" letter-spacing="1.5" font-family="'DM Mono', monospace">The Capital Logic Behind Governance Failure</text>
    <text x="600" y="74" text-anchor="middle" fill="#9fb0c8" font-size="12" letter-spacing="1">治理失敗背後的資本底層邏輯</text>
    <text x="600" y="98" text-anchor="middle" fill="#c8f542" font-size="13" letter-spacing="1">What cannot be measured cannot be repaired.</text>
    <text x="600" y="118" text-anchor="middle" fill="#4a6080" font-size="11" letter-spacing="1">無法測量，就無法修復。</text>

    <!-- 核心四句 -->
    <rect x="200" y="138" width="800" height="52" rx="10" fill="rgba(159,232,112,0.06)" stroke="rgba(159,232,112,0.15)" stroke-width="1"/>
    <text x="600" y="158" text-anchor="middle" fill="#9FE870" font-size="12" font-family="'DM Mono', monospace">OECD defined the governance gap.</text>
    <text x="600" y="175" text-anchor="middle" fill="#c8f542" font-size="12" font-family="'DM Mono', monospace">Ghost GDP names the hidden loss.</text>
    <text x="600" y="192" text-anchor="middle" fill="#7DD3FC" font-size="12" font-family="'DM Mono', monospace">GL Framework measures it.</text>
    <text x="600" y="209" text-anchor="middle" fill="#c7d2e3" font-size="12" font-family="'DM Mono', monospace">Independent verification turns measurement into accountability.</text>

    <!-- 箭頭 -->
    <line x1="600" y1="222" x2="600" y2="250" stroke="#7DD3FC" stroke-width="2" marker-end="url(#arrowBlue)" filter="url(#glow)"/>

    <!-- OECD 缺口 -->
    <rect x="450" y="262" width="300" height="56" rx="12" fill="rgba(125,211,252,0.12)" stroke="#7DD3FC" stroke-width="1.5" filter="url(#shadow)"/>
    <text x="600" y="285" text-anchor="middle" fill="#7DD3FC" font-size="12" font-weight="600" font-family="'DM Mono', monospace">OECD 缺口</text>
    <text x="600" y="304" text-anchor="middle" fill="#c7d2e3" font-size="11">法律獨立 ≠ 實踐獨立</text>
    <text x="780" y="290" fill="#4a6080" font-size="10" font-family="'DM Mono', monospace">OECD/IDI · 05/27/2026</text>

    <line x1="600" y1="318" x2="600" y2="348" stroke="#7DD3FC" stroke-width="2" marker-end="url(#arrowBlue)" filter="url(#glow)"/>
    <text x="620" y="338" fill="#4a6080" font-size="9" font-family="'DM Mono', monospace">產生</text>

    <!-- 治理缺口 -->
    <rect x="300" y="358" width="600" height="72" rx="14" fill="rgba(255,107,107,0.08)" stroke="#ff6b6b" stroke-width="1.5" stroke-dasharray="6,3" filter="url(#shadow)"/>
    <text x="600" y="383" text-anchor="middle" fill="#ff6b6b" font-size="14" font-weight="700" font-family="'DM Mono', monospace">治理缺口 · Governance Gap</text>
    <text x="600" y="403" text-anchor="middle" fill="#c7d2e3" font-size="11">現有工具無法測量實際運作成果</text>
    <text x="600" y="420" text-anchor="middle" fill="#9fb0c8" font-size="10">無法驗證公共投資是否真正改善服務交付</text>

    <line x1="600" y1="430" x2="600" y2="460" stroke="#ff6b6b" stroke-width="2" marker-end="url(#arrowRed)" filter="url(#glow)"/>
    <text x="620" y="450" fill="#4a6080" font-size="9" font-family="'DM Mono', monospace">造成</text>

    <!-- 行政摩擦 -->
    <rect x="200" y="470" width="800" height="80" rx="12" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
    <text x="600" y="492" text-anchor="middle" fill="#9fb0c8" font-size="11" font-weight="600">行政摩擦 · Administrative Friction</text>

    <rect x="220" y="502" width="135" height="36" rx="8" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.08)"/>
    <text x="287" y="524" text-anchor="middle" fill="#c7d2e3" font-size="10">等待 · Waiting</text>

    <rect x="370" y="502" width="135" height="36" rx="8" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.08)"/>
    <text x="437" y="524" text-anchor="middle" fill="#c7d2e3" font-size="10">重複 · Repetition</text>

    <rect x="520" y="502" width="135" height="36" rx="8" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.08)"/>
    <text x="587" y="524" text-anchor="middle" fill="#c7d2e3" font-size="10">崩潰 · Collapse</text>

    <rect x="670" y="502" width="135" height="36" rx="8" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.08)"/>
    <text x="737" y="524" text-anchor="middle" fill="#c7d2e3" font-size="10">資訊不對稱 · Asymmetry</text>

    <rect x="820" y="502" width="160" height="36" rx="8" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.08)"/>
    <text x="900" y="524" text-anchor="middle" fill="#c7d2e3" font-size="10">心理摩擦 · Psychology</text>

    <line x1="600" y1="550" x2="600" y2="580" stroke="#fbbf24" stroke-width="2" marker-end="url(#arrowGold)" filter="url(#glow)"/>
    <text x="620" y="570" fill="#4a6080" font-size="9" font-family="'DM Mono', monospace">形成</text>

    <!-- 幽靈GDP -->
    <rect x="350" y="590" width="500" height="64" rx="14" fill="rgba(200,245,66,0.08)" stroke="#c8f542" stroke-width="2" filter="url(#shadow)"/>
    <text x="600" y="616" text-anchor="middle" fill="#c8f542" font-size="16" font-weight="700" font-family="'DM Mono', monospace">Ghost GDP · 幽靈GDP</text>
    <text x="600" y="638" text-anchor="middle" fill="#c7d2e3" font-size="11">沒有被計入帳面的經濟損失 → 被轉嫁給公民的沉默成本</text>

    <line x1="600" y1="654" x2="600" y2="684" stroke="#c8f542" stroke-width="2" marker-end="url(#arrowGreen)" filter="url(#glow)"/>
    <text x="620" y="674" fill="#4a6080" font-size="9" font-family="'DM Mono', monospace">需要測量</text>

    <!-- GL Framework -->
    <rect x="250" y="694" width="700" height="76" rx="16" fill="rgba(159,232,112,0.12)" stroke="#9FE870" stroke-width="2" filter="url(#shadow)"/>
    <text x="600" y="720" text-anchor="middle" fill="#9FE870" font-size="18" font-weight="700" font-family="'DM Mono', monospace">GL Framework</text>
    <text x="600" y="740" text-anchor="middle" fill="#c7d2e3" font-size="11">A field-based diagnostic methodology for measuring administrative friction</text>
    <text x="600" y="758" text-anchor="middle" fill="#9fb0c8" font-size="10">Converts administrative friction into measurable parameters</text>

    <line x1="600" y1="770" x2="600" y2="798" stroke="#9FE870" stroke-width="2" marker-end="url(#arrowGreen)" filter="url(#glow)"/>

    <!-- EO 14402 + GL Verifier -->
    <rect x="250" y="808" width="300" height="64" rx="12" fill="rgba(125,211,252,0.08)" stroke="#7DD3FC" stroke-width="1.5"/>
    <text x="400" y="832" text-anchor="middle" fill="#7DD3FC" font-size="13" font-weight="600" font-family="'DM Mono', monospace">EO 14402</text>
    <text x="400" y="850" text-anchor="middle" fill="#c7d2e3" font-size="10">固定價格合約為預設</text>
    <text x="400" y="864" text-anchor="middle" fill="#c7d2e3" font-size="10">要求獨立成果驗證</text>

    <line x1="550" y1="840" x2="610" y2="840" stroke="#7DD3FC" stroke-width="2" marker-end="url(#arrowBlue)" filter="url(#glow)"/>

    <rect x="620" y="808" width="300" height="64" rx="12" fill="rgba(159,232,112,0.1)" stroke="#9FE870" stroke-width="1.5"/>
    <text x="770" y="832" text-anchor="middle" fill="#9FE870" font-size="13" font-weight="600" font-family="'DM Mono', monospace">GL Verifier</text>
    <text x="770" y="850" text-anchor="middle" fill="#c7d2e3" font-size="10">獨立第三方驗證標準</text>
    <text x="770" y="864" text-anchor="middle" fill="#c7d2e3" font-size="10">Verifier pathway under development</text>

    <!-- 底部金句 -->
    <text x="600" y="920" text-anchor="middle" fill="#c8f542" font-size="13" font-weight="600" font-family="'DM Mono', monospace" letter-spacing="1">
      Capital cannot optimize what it cannot measure.
    </text>
  </svg>
</div>
</body>
</html>
